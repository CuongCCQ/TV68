<resources>
    <style name="Theme.TVHome" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="alertDialogTheme">@style/Dialog</item>
    </style>
    <style name="Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
    </style>
    <style name="TvButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/pill</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
    <style name="SettingsButton" parent="TvButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">20sp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>
